{
    "name": "php-io-extensions/box2d",
    "type": "php-ext",
    "description": "1:1 PHP bindings of Box2D 3.1.1, with the library compiled into the extension",
    "keywords": [
        "box2d",
        "physics",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "box2d",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-box2d",
                "description": "Enable the Box2D 3.1.1 bindings",
                "needs-value": false
            }
        ]
    }
}
